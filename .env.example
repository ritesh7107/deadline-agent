# Free: https://aistudio.google.com/apikey - no card, no billing account.
GEMINI_API_KEY=...

# Swap providers with one line. Anything Pydantic AI supports works:
#   MODEL=google:gemini-2.5-flash          (default)
#   MODEL=groq:llama-3.3-70b-versatile     needs GROQ_API_KEY
#   MODEL=anthropic:claude-haiku-4-5-20251001   needs ANTHROPIC_API_KEY
#   MODEL=openai:gpt-4o-mini               needs OPENAI_API_KEY
MODEL=google:gemini-2.5-flash

# Requests per minute. 10 suits the Gemini free tier; raise it on a paid one.
RPM=10

# Pinned clock, so "this week" means the same thing on any machine.
NOW=2026-08-25
